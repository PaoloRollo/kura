# ---- contracts (Foundry) ----
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
SIGNER_ADDRESS=
SIGNER_PRIVATE_KEY=
VENDOR_ADDRESS=
VENDOR_PAYOUT_ADDRESS=
VENDOR_FEE_BPS=250
VENDOR_PRIVATE_KEY=
DEMO_OWNER=
VAULT_ENS_LABEL=kura
BASE_URI=https://kura.example/api/meta/
SITE_URI=https://kura.example/app/cards/
ETHERSCAN_API_KEY=
# ENSv2 Sepolia overrides (leave empty to use the defaults in EnsEnv, from ensdomains/contracts-v2@48b3e2d deployments/sepolia)
ENS_ETH_REGISTRY=
ENS_ETH_REGISTRAR=
ENS_VERIFIABLE_FACTORY=
ENS_USER_REGISTRY_IMPL=
ENS_RESOLVER_IMPL=
ENS_FEE_TOKEN=

# ---- web (Next.js) ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
NEXT_PUBLIC_WORLD_ENV=staging
# Staging/sandbox proofs need an open staging window; its token (valid 24 h) comes from the Developer Portal.
WORLD_STAGING_VERIFICATION_TOKEN=
WORLD_ENV=staging
WORLD_RELEASE_CREDENTIALS=passport
# Accept legacy World ID 3.0 proofs for bidding (default off: legacy and v4 nullifiers differ, so one human could bind two wallets)
# WORLD_BID_ALLOW_LEGACY=true
# NEXT_PUBLIC_WORLD_BID_ALLOW_LEGACY=true
DATABASE_URL=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_ALCHEMY_HTTP_URL=
NEXT_PUBLIC_ALCHEMY_WS_URL=
ALCHEMY_HTTP_URL=
ALCHEMY_WS_URL=
NEXT_PUBLIC_PONDER_URL=http://localhost:42069
PONDER_URL=http://localhost:42069
APPRAISER_WRITE_ENS=false
CRON_SECRET=
# MultiBaas (Curvegrid), optional: the dashboard's 24h figures, the recent vault events panel and the settlement webhook.
# Server-only, never NEXT_PUBLIC_. The setup script reads this root .env; the web dev server reads apps/web/.env.local.
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
# Printed once by `pnpm multibaas:setup --apply --webhook-base https://…` (again with --show-secret). Until it is set the webhook answers 503.
MULTIBAAS_WEBHOOK_SECRET=
# Card image index directory, read at request time by the scan station; git-ignored, so deploys must provision it separately (default: apps/web/data/card-index)
# CARD_INDEX_DIR=apps/web/data/card-index
# Card index base URL (Vercel Blob, printed by pnpm --filter web upload:index); when set it is used instead of CARD_INDEX_DIR
# CARD_INDEX_URL=https://<store>.private.blob.vercel-storage.com/card-index/<version>
# Blob store access for upload:index and the loader (default private); a private store is read with BLOB_READ_WRITE_TOKEN, which Vercel injects when the store is connected
# CARD_INDEX_BLOB_ACCESS=private
# Set by Vercel when the Blob store is connected; needed locally only for upload:index
# BLOB_READ_WRITE_TOKEN=

# ---- indexer (Ponder) ----
PONDER_RPC_URL_11155111=
PONDER_WS_URL_11155111=
DATABASE_SCHEMA=kura_dev
PONDER_LOG_LEVEL=info

# ---- rehearsal (pnpm rehearse) ----
# Seed wallets for the demo data: addressIndex 0-1 are the owners, 2-5 the bidders (seedaiko ... seedyuki.kura.eth).
# Required for --broadcast; --dry-run uses a throwaway mnemonic when empty. Also reads DEPLOYER_PRIVATE_KEY (funds the
# wallets), VENDOR_PRIVATE_KEY, SIGNER_PRIVATE_KEY, ALCHEMY_HTTP_URL and, after a broadcast, PONDER_URL.
SEED_MNEMONIC=
